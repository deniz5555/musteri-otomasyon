# SMTP E-posta Ayarları
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Şirket Adınız

# AI API Ayarları (OpenAI veya Gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key-here
GEMINI_API_KEY=your-gemini-key-here

# Sunucu Ayarları
PORT=3001
NODE_ENV=development

# SMTP bulut (Railway) IPv6 timeout: varsayılan 4. Sorun sürerse SMTP_DEBUG=1 ile Railway loglarına detay basın.
# SMTP_IP_FAMILY=4
# SMTP_DEBUG=0

# Takip E-posta Ayarları (gün cinsinden)
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=7
FOLLOWUP_3_DAYS=14
